# Hook / Hook backend — environment variables.
# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# ---------------------------------------------------------------------------
# Groq (AI generation) — REQUIRED, the app refuses to start without it.
# ---------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_key_here

# Optional Groq overrides; the defaults in main.py are what production uses.
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
# GROQ_REASONING_EFFORT=none
# MAX_OUTPUT_TOKENS=320

# ---------------------------------------------------------------------------
# Gemini (peer provider in the failover queue) — optional but recommended.
# ---------------------------------------------------------------------------
# When set, Groq and Gemini rotate: whoever fails is demoted until the other
# fails. The client only sees "catching its breath" (HTTP 429) when BOTH are
# rate-limited. Unset = Groq-only.
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash-lite

# ---------------------------------------------------------------------------
# App authentication
# ---------------------------------------------------------------------------
# Shared secret every client must send as the X-Api-Key header. Ship the same
# value in the Android app. Compared in constant time.
# If UNSET the check is skipped entirely (convenient for local dev) and the
# server prints a loud warning at startup — never deploy without it, or anyone
# who finds the URL can burn the paid Groq quota.
APP_API_KEY=generate_a_long_random_string

# ---------------------------------------------------------------------------
# RevenueCat (Hook Pro entitlements)
# ---------------------------------------------------------------------------
# Secret API key from RevenueCat > Project Settings > API keys. SERVER-SIDE
# ONLY — this is not the public SDK key that ships in the app.
# If unset, nobody is treated as Pro and everyone is capped at the free
# allowance (the server logs a warning once).
REVENUECAT_SECRET_KEY=sk_your_revenuecat_secret_key

# Entitlement identifier configured in RevenueCat. Default: pro
# REVENUECAT_ENTITLEMENT_ID=pro

# How long (seconds) an entitlement answer is cached per app user id, to avoid
# one RevenueCat call per generation. Default: 60
# ENTITLEMENT_CACHE_TTL_SECONDS=60

# Override the RevenueCat REST base URL (testing only). Default:
# REVENUECAT_API_BASE=https://api.revenuecat.com/v1

# ---------------------------------------------------------------------------
# Free allowance (Variant A: lifetime free generations, then subscribe)
# ---------------------------------------------------------------------------
# Lifetime free generations per install before HTTP 402. Default: 5
FREE_GENERATION_LIMIT=5

# --- Durable allowance storage (recommended for production) ---
# Set BOTH of these to store counters in Supabase. Apply supabase_schema.sql in
# the Supabase SQL editor first (it creates the table, enables RLS, and adds the
# atomic increment_allowance() function).
# SUPABASE_URL=https://your-project-ref.supabase.co
#
# The SERVICE ROLE key (Dashboard > Project Settings > API). It bypasses RLS,
# which is exactly why it must stay server-side: never ship it in the Android
# app, never expose it to a browser, never commit it.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Fallback SQLite file, used whenever Supabase is not configured (or is
# unreachable at startup). Default: ./allowance.db
# WARNING: on ephemeral hosting (Render free tier, most containers) this file is
# wiped on every redeploy, which resets everyone's free allowance.
# ALLOWANCE_DB_PATH=./allowance.db

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. Default: empty, i.e.
# no browser origin is allowed. The Android app is not a browser and needs
# nothing here; only add the marketing site if it ever calls the API directly.
# ALLOWED_ORIGINS=https://hookapp.example,https://www.hookapp.example

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# PORT=8000
